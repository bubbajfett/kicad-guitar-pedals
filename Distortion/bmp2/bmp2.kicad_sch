  (text "sustain\n" (at 35.687 101.981 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid 6f7ae7b5-94b8-459d-a7a5-5d579847c3c0)
  )
  (text "This appears to be same schematic as fuzzdog build doc.   They mention \ndecreasing R17, R18 to 10K to reduce gain.    This build motorboats a bit\nat high volume/sustain levels, but it's really very high gain circuit.\n\nThis is based on the GigaHearts FX schematic I found online."
    (at 203.962 148.59 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid b3e4ed90-5b6f-4c74-bda0-2b1642d021c9)
  )
  (text "based on gigahearts fx schematic. " (at 251.206 15.621 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid f677abb5-b486-4b7d-acac-f608250b9121)
  )

